# ── CorvusTunnel Production Image ─────────────────────────────────────
# Open-core: No obfuscation. Source shipped as-is (MIT licensed).
FROM python:3.11-slim

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates procps bubblewrap \
    && rm -rf /var/lib/apt/lists/*

# Cloudflared
RUN curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64.deb \
    -o /tmp/cloudflared.deb && dpkg -i /tmp/cloudflared.deb && rm /tmp/cloudflared.deb

# Create non-root user
RUN groupadd -r corvus && useradd -r -g corvus -m -d /home/corvus -s /bin/bash corvus

# Python dependencies
WORKDIR /app
COPY pyproject.toml requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy application source (open-core, MIT licensed)
COPY . .
RUN chown -R corvus:corvus /app

# Workspace
RUN mkdir -p /workspace && chown corvus:corvus /workspace
RUN chmod +x /app/entrypoint.sh

USER corvus

# Pre-create keys directory
RUN mkdir -p /home/corvus/.corvustunnel/keys

EXPOSE 8000 8001
VOLUME /workspace

ENTRYPOINT ["/app/entrypoint.sh"]
